<Window x:Class="StudentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentApp"
        mc:Ignorable="d"
        Title="Информация о студентах" Height="450" Width="600"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть - форма ввода -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <Label Content="Фамилия:"/>
            <TextBox x:Name="txtLastName" Margin="0,0,0,10"/>

            <Label Content="Имя:"/>
            <TextBox x:Name="txtFirstName" Margin="0,0,0,10"/>

            <Label Content="Отчество:"/>
            <TextBox x:Name="txtMiddleName" Margin="0,0,0,10"/>

            <Label Content="Группа:"/>
            <TextBox x:Name="txtGroup" Margin="0,0,0,10"/>

            <Label Content="Пол:"/>
            <ComboBox x:Name="cmbGender" Margin="0,0,0,10">
                <ComboBoxItem Content="Мужской" Tag="Male"/>
                <ComboBoxItem Content="Женский" Tag="Female"/>
                <ComboBoxItem Content="Другой" Tag="Other"/>
            </ComboBox>

            <Label Content="Дата рождения:"/>
            <DatePicker x:Name="dpBirthDate" Margin="0,0,0,20"/>

            <Button x:Name="btnSave" Content="Сохранить" Click="btnSave_Click"/>
        </StackPanel>

        <!-- Правая часть - список студентов -->
        <StackPanel Grid.Column="1">
            <Label Content="Список студентов:"/>
            <ListBox x:Name="lstStudents" Height="300" 
                     DisplayMemberPath="LastName"/>
            <Button x:Name="btnDelete" Content="Удалить" 
                    Margin="0,10,0,0" Click="btnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>