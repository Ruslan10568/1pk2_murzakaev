<Window x:Class="Task_38_04.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_38_04"
        mc:Ignorable="d"
        Title="Учет студентов - Task_38_04" Height="500" Width="700"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Форма ввода данных -->
        <GroupBox Grid.Column="0" Header="Данные студента" Margin="0,0,10,0">
            <StackPanel>
                <Label Content="Фамилия:"/>
                <TextBox x:Name="txtLastName" Margin="0,0,0,10"/>

                <Label Content="Имя:"/>
                <TextBox x:Name="txtFirstName" Margin="0,0,0,10"/>

                <Label Content="Отчество:"/>
                <TextBox x:Name="txtMiddleName" Margin="0,0,0,10"/>

                <Label Content="Группа:"/>
                <TextBox x:Name="txtGroup" Margin="0,0,0,10"/>

                <Label Content="Пол:"/>
                <ComboBox x:Name="cmbGender" Margin="0,0,0,10">
                    <ComboBoxItem Content="Мужской" Tag="Male"/>
                    <ComboBoxItem Content="Женский" Tag="Female"/>
                    <ComboBoxItem Content="Другой" Tag="Other"/>
                </ComboBox>

                <Label Content="Дата рождения:"/>
                <DatePicker x:Name="dpBirthDate" Margin="0,0,0,20"/>

                <Button x:Name="btnSave" Content="Сохранить" Click="btnSave_Click"
                        Background="#FF4CAF50" Foreground="White" Padding="10,5"/>
            </StackPanel>
        </GroupBox>

        <!-- Список студентов -->
        <GroupBox Grid.Column="1" Header="Список студентов">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnDelete" Content="Удалить" Margin="0,0,10,0" 
                            Click="btnDelete_Click" Padding="10,5"/>
                    <Button x:Name="btnClear" Content="Очистить список" 
                            Click="btnClear_Click" Padding="10,5"/>
                </StackPanel>
                <ListBox x:Name="lstStudents" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LastName}" FontWeight="Bold" Width="120"/>
                                <TextBlock Text="{Binding FirstName}" Width="100"/>
                                <TextBlock Text="{Binding Group}" Width="80" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding BirthDate, StringFormat='dd.MM.yyyy'}" Width="80"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>