<Window x:Class="Task_39_02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список покупок" Height="450" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ввод нового продукта -->
        <StackPanel Grid.Row="0">
            <Label Content="Добавить продукт:"/>
            <TextBox x:Name="txtNewItem" Margin="0,0,0,10"/>
            <Button x:Name="btnAdd" Content="Добавить" Click="btnAdd_Click"/>
        </StackPanel>

        <!-- Список продуктов -->
        <ListBox x:Name="lstItems" Grid.Row="1" Margin="0,10,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnRemove" Content="Удалить" Margin="0,0,10,0" Click="btnRemove_Click"/>
            <Button x:Name="btnSave" Content="Сохранить в файл" Click="btnSave_Click"/>
            <Button x:Name="btnLoad" Content="Загрузить из файла" Margin="10,0,0,0" Click="btnLoad_Click"/>
        </StackPanel>
    </Grid>
</Window>